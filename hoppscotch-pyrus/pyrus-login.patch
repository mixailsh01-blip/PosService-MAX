diff --git a/packages/hoppscotch-common/src/helpers/sprt-seed.ts b/packages/hoppscotch-common/src/helpers/sprt-seed.ts
new file mode 100644
index 0000000..2e27eb8
--- /dev/null
+++ b/packages/hoppscotch-common/src/helpers/sprt-seed.ts
@@ -0,0 +1,120 @@
+// СПРТ: on the first sign-in every employee gets the iiko Cloud API
+// collection and environment in their personal workspace.
+import { HoppCollection } from "@hoppscotch/data"
+import * as E from "fp-ts/Either"
+import {
+  restCollectionStore,
+  appendRESTCollections,
+  editRESTCollection,
+  removeRESTCollection,
+} from "~/newstore/collections"
+import {
+  environmentsStore,
+  createEnvironment,
+  addEnvironmentVariable,
+} from "~/newstore/environments"
+import {
+  ensureRefIds,
+  populateLocalStoresFromCollectionTree,
+  stripCollectionTreeForStore,
+} from "~/helpers/clientLocalVariables"
+import { sanitizeCollection } from "~/helpers/import-export/import"
+import { sync } from "~/lib/sync/defs"
+import { ReqType } from "~/helpers/backend/graphql"
+
+const SEED_VERSION = "v3"
+// маркер в скрипте новой коллекции: по нему отличаем её от версии v1
+const NEW_MARK = "автоматизация iiko Cloud API (v3)"
+// маркер предыдущей версии (v2): такая коллекция создана этим же сидом и заменяется новой
+const V2_MARK = "автоматизация iiko Cloud API"
+const OLD_SUFFIX = " — старая версия, можно удалить"
+const COLLECTION_NAME = "iiko Cloud API (СПРТ)"
+const ENV_NAME = "iiko Cloud API"
+
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms))
+
+export async function seedSprtDefaults(uid: string) {
+  const flag = `sprt_seed_${SEED_VERSION}_${uid}`
+  try {
+    if (localStorage.getItem(flag)) return
+  } catch {
+    return
+  }
+
+  // give workspace sync a moment to load what is already on the server
+  await sleep(5000)
+
+  try {
+    const isNew = (c: { name: string; preRequestScript?: string }) =>
+      c.name === COLLECTION_NAME && String(c.preRequestScript ?? "").includes(NEW_MARK)
+    const hasCollection = restCollectionStore.value.state.some(isNew)
+
+    if (!hasCollection) {
+      // коллекции из прошлых версий: версию v2 (создана этим же сидом, вход по старой схеме) удаляем,
+      // всё остальное с тем же именем (v1, правки пользователя) только переименовываем
+      const state = restCollectionStore.value.state as {
+        name: string
+        preRequestScript?: string
+      }[]
+      for (let i = state.length - 1; i >= 0; i--) {
+        const c = state[i]
+        if (c.name !== COLLECTION_NAME || isNew(c)) continue
+        if (String(c.preRequestScript ?? "").includes(V2_MARK)) {
+          removeRESTCollection(i)
+        } else {
+          editRESTCollection(i, { name: COLLECTION_NAME + OLD_SUFFIX })
+        }
+      }
+      const raw = (await import("../../assets/sprt/iiko-cloud-api.collection.json"))
+        .default
+      const parsed = HoppCollection.safeParse(raw)
+      if (parsed.type === "ok") {
+        const sanitized = [parsed.value]
+          .map(sanitizeCollection)
+          .map(ensureRefIds)
+        sanitized.forEach(populateLocalStoresFromCollectionTree)
+        if (sync.collections.importToPersonalWorkspace) {
+          const res = await sync.collections.importToPersonalWorkspace(
+            sanitized,
+            ReqType.Rest
+          )
+          if (!E.isRight(res)) {
+            appendRESTCollections(sanitized.map(stripCollectionTreeForStore))
+          }
+        } else {
+          appendRESTCollections(sanitized.map(stripCollectionTreeForStore))
+        }
+      }
+    }
+
+    const env = (await import("../../assets/sprt/iiko-cloud-api.environment.json"))
+      .default
+    const envIndex = environmentsStore.value.environments.findIndex(
+      (e: { name: string }) => e.name === ENV_NAME
+    )
+    if (envIndex < 0) {
+      createEnvironment(env.name, env.variables)
+    } else {
+      // окружение уже есть: добавляем недостающие переменные, ничего не трогая (apiLogin остаётся)
+      const have = new Set(
+        environmentsStore.value.environments[envIndex].variables.map(
+          (v: { key: string }) => v.key
+        )
+      )
+      env.variables
+        .filter((v: { key: string }) => !have.has(v.key))
+        .forEach((v: { key: string; initialValue: string; currentValue: string; secret: boolean }) =>
+          addEnvironmentVariable(envIndex, {
+            key: v.key,
+            initialValue: v.initialValue,
+            currentValue: v.currentValue,
+            secret: v.secret,
+          })
+        )
+    }
+
+    localStorage.setItem(flag, "1")
+  } catch (e) {
+    console.error("[sprt-seed] failed", e)
+  }
+}
