diff --git a/packages/hoppscotch-common/src/components/sprt/LoginGate.vue b/packages/hoppscotch-common/src/components/sprt/LoginGate.vue
new file mode 100644
index 0000000..70baf43
--- /dev/null
+++ b/packages/hoppscotch-common/src/components/sprt/LoginGate.vue
@@ -0,0 +1,383 @@
+<template>
+  <div class="sprt-gate">
+    <div class="glow glow-a"></div>
+    <div class="glow glow-b"></div>
+
+    <main class="card">
+      <svg class="logo" viewBox="0 0 440 100" role="img" aria-label="SPRT">
+        <g v-for="(l, i) in ['S', 'P', 'R', 'T']" :key="l" class="tile" :style="{ '--i': i }">
+          <rect :x="i * 113" y="0" width="100" height="100" rx="22" />
+          <text :x="i * 113 + 50" y="72" font-size="64" text-anchor="middle">{{ l }}</text>
+        </g>
+      </svg>
+
+      <p class="tagline"><b>Надёжная</b> поддержка Вашего бизнеса</p>
+      <h1 class="title">API-клиент</h1>
+
+      <form v-if="!sent" class="form" @submit.prevent="submit">
+        <p class="hint">Вход для сотрудников СПРТ по рабочей почте</p>
+        <label class="field">
+          <span>Электронная почта</span>
+          <input
+            v-model.trim="email"
+            type="email"
+            name="email"
+            autocomplete="email"
+            placeholder="name@sprt-service.ru"
+            required
+            autofocus
+            :disabled="loading"
+          />
+        </label>
+        <p v-if="error" class="error" role="alert">{{ error }}</p>
+        <button class="btn" type="submit" :disabled="loading || !email">
+          <span v-if="!loading">Получить ссылку для входа</span>
+          <span v-else class="spinner" aria-label="Отправка"></span>
+        </button>
+      </form>
+
+      <div v-else class="sent">
+        <div class="mail" aria-hidden="true">✉</div>
+        <h2>Проверьте почту</h2>
+        <p class="hint">
+          Мы отправили ссылку для входа в <b>Pyrus</b>: откройте новую задачу
+          «Вход в API-клиент СПРТ» и перейдите по ссылке. Копия ушла на почту
+          <b>{{ email }}</b> (проверьте и «Спам»).
+        </p>
+        <p class="hint small">
+          Открывайте ссылку в этом же браузере, где запрашивали вход.
+        </p>
+        <button class="link" type="button" @click="reset">
+          Изменить почту
+        </button>
+      </div>
+
+      <p class="foot">Доступ только для сотрудников из Pyrus</p>
+    </main>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { ref } from "vue"
+import { platform } from "~/platform"
+import { useService } from "dioc/vue"
+import { PersistenceService } from "~/services/persistence"
+
+const persistence = useService(PersistenceService)
+
+const email = ref("")
+const loading = ref(false)
+const sent = ref(false)
+const error = ref("")
+
+// once logged in, the layout removes this gate by itself
+const submit = async () => {
+  if (!email.value || loading.value) return
+  loading.value = true
+  error.value = ""
+  try {
+    await platform.auth.signInWithEmail(email.value)
+    await persistence.setLocalConfig("emailForSignIn", email.value)
+    sent.value = true
+  } catch (e: any) {
+    const status = e?.response?.status
+    if (status === 403) {
+      error.value =
+        "Эта почта не найдена среди сотрудников в Pyrus. Войти можно только по рабочей почте."
+    } else if (status === 502) {
+      error.value = "Не удалось отправить ссылку ни в Pyrus, ни на почту. Попробуйте ещё раз."
+    } else if (status === 400) {
+      error.value = "Проверьте адрес электронной почты."
+    } else {
+      error.value = "Не удалось отправить письмо. Попробуйте ещё раз чуть позже."
