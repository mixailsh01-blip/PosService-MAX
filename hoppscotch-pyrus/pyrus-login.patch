+  "variables": [],
+  "description": "Коллекция методов iiko Cloud API (api-ru.iiko.services) с автоматизацией для СПРТ.\n\nЧто нужно сделать один раз: выбрать окружение «iiko Cloud API» (справа вверху) и вписать apiLogin (API-ключ из iikoWeb).\n\nДальше всё само:\n• токен получается и обновляется перед каждым запросом;\n• organizationId, terminalGroupId, productId, paymentTypeId, tableId и другие ID подставляются в тело запроса автоматически;\n• orderId, correlationId, customerId запоминаются из ответов, и следующие запросы используют их;\n• даты можно писать как <<todayStart>>, <<todayEnd>>, <<weekAgoStart>>, <<now>>, <<nowPlus1h>>; <<guid>> и <<orderNumber>> дают новый GUID и номер заказа;\n• ошибка iiko (errorDescription) показывается во вкладке «Тесты»; просроченный токен обновляется сам.\n\nНачните с папки «⚡ Быстрый старт». Методы, помеченные «(создаёт заказ!)», создают реальные заказы на кассе.\n\nСправка по методам: https://api-ru.iiko.services/docs",
+  "preRequestScript": "// СПРТ • автоматизация iiko Cloud API (v4, server proxy).\n// Выполняется перед каждым запросом коллекции: сама получает токен и подставляет ID.\n// Вручную нужно вписать только apiLogin (API-ключ из iikoWeb) в окружении «iiko Cloud API».\n// clientSecret приложения хранится на сервере СПРТ (сервис iiko-auth).\nconst get = (k) => {\n  const v = pw.env.get(k)\n  return v === undefined || v === null ? \"\" : String(v)\n}\nconst set = (k, v) => pw.env.set(k, v === undefined || v === null ? \"\" : String(v))\n\nconst here = globalThis.location\nconst serviceOrigin = here && (here.hostname === \"localhost\" || here.hostname === \"127.0.0.1\")\n  ? \"http://localhost:8081\"\n  : ((here && here.origin) || \"https://sprtapi.sprt-service.ru\")\nconst base = (get(\"baseUrl\") || serviceOrigin + \"/iiko-api\").replace(/\\/+$/, \"\")\nconst url = String(hopp.request.url || \"\")\nconst reqBody = hopp.request.body\nconst raw = url + \" \" + (reqBody && typeof reqBody.body === \"string\" ? reqBody.body : \"\")\nconst used = (name) => raw.includes(\"<<\" + name + \">>\")\nconst isAuthCall = /\\/(access_token|token)(\\?|$)/.test(url)\n\n// ---- динамические значения: даты, GUID, номер заказа ----\nconst pad = (n, l = 2) => String(n).padStart(l, \"0\")\nconst fmt = (d) =>\n  `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ` +\n  `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}.${pad(d.getMilliseconds(), 3)}`\nconst now = new Date()\nconst dayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0, 0)\nconst dayEnd = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59, 999)\nconst guid = () =>\n  \"xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx\".replace(/[xy]/g, (c) => {\n    const r = (Math.random() * 16) | 0\n    return (c === \"x\" ? r : (r & 0x3) | 0x8).toString(16)\n  })\nset(\"todayStart\", fmt(dayStart))\nset(\"todayEnd\", fmt(dayEnd))\nset(\"weekAgoStart\", fmt(new Date(dayStart.getTime() - 7 * 86400000)))\nset(\"now\", fmt(now))\nset(\"nowPlus1h\", fmt(new Date(now.getTime() + 3600000)))\nset(\"guid\", guid())\nset(\"orderNumber\", \"SPRT-\" + Math.floor(now.getTime() / 1000))\n\n// ---- обращение к API ----\nasync function call(path, body, auth = true) {\n  const headers = { \"Content-Type\": \"application/json\" }\n  if (auth) headers.Authorization = \"Bearer \" + get(\"token\")\n  const res = await fetch(base + path, { method: \"POST\", headers, body: JSON.stringify(body || {}) })\n  let data = null\n  try { data = await res.json() } catch (_) { /* пустой ответ */ }\n  if (!res.ok) {\n    const why = (data && (data.errorDescription || data.message || data.error)) || \"\"\n    throw new Error(`iiko ${path}: ${res.status} ${why}`)\n  }\n  return data\n}\n\nif (!isAuthCall) {\n  // 1. токен (живёт ~1 час, обновляем за 10 минут до конца)\n  const age = Date.now() - Number(get(\"tokenTime\") || 0)\n  if (!get(\"token\") || age > 50 * 60 * 1000) {\n    const login = get(\"apiLogin\")\n    if (!login) {\n      throw new Error(\"СПРТ: впишите apiLogin (API-ключ из iikoWeb) в окружении «iiko Cloud API» (значок окружений справа вверху).\")\n    }\n    // clientSecret хранится только на сервере СПРТ и не показывается в окружении.\n    // Локальная разработка использует порт 8081, опубликованный сайт — тот же домен.\n    const authService = here && (here.hostname === \"localhost\" || here.hostname === \"127.0.0.1\")\n      ? \"http://localhost:8081\"\n      : ((here && here.origin) || \"https://sprtapi.sprt-service.ru\") + \"/iiko-auth\"\n    const res = await fetch(authService + \"/token\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ apiKey: login }) })\n    let t\n    try { t = await res.json() } catch (_) { t = null }\n    if (!res.ok) {\n      const why = (t && (t.errorDescription || t.message || t.error)) || \"\"\n      throw new Error(`СПРТ: не удалось получить токен (${res.status}) ${why}`)\n    }\n    if (t && !t.token) t.token = t.accessToken || t.access_token\n    set(\"token\", t.token)\n    set(\"tokenTime\", Date.now())\n  }\n\n  // 2. организация — если запрос на неё ссылается, а она ещё не выбрана\n  const needs = (k) => used(k) && !get(k)\n  const dependent = [\"terminalGroupId\", \"productId\", \"productPrice\", \"paymentTypeId\", \"paymentTypeKind\", \"orderTypeId\", \"employeeId\", \"externalMenuId\", \"tableId\"]\n  if ((needs(\"organizationId\") || dependent.some(needs)) && !get(\"organizationId\")) {\n    const r = await call(\"/api/1/organizations\", { returnAdditionalInfo: false, includeDisabled: false })\n    const orgs = (r && r.organizations) || []\n    if (!orgs.length) throw new Error(\"СПРТ: для этого apiLogin нет доступных организаций\")\n    set(\"organizationId\", orgs[0].id)\n    set(\"organizationName\", orgs[0].name)\n    set(\"organizationsList\", orgs.map((o, i) => `${i + 1}) ${o.name} — ${o.id}`).join(\"\\n\"))\n  }\n\n  // 3. остальные справочные ID — по необходимости (ошибка здесь не должна ломать запрос)\n  const org = get(\"organizationId\")\n  const lazy = async (keys, fn) => {\n    if (!keys.some(needs)) return\n    try { await fn() } catch (e) { console.log(\"СПРТ: не удалось подставить \" + keys.join(\"/\") + \": \" + e.message) }\n  }\n  await lazy([\"terminalGroupId\"], async () => {\n    const r = await call(\"/api/1/terminal_groups\", { organizationIds: [org], includeDisabled: false })\n    const t = r && r.terminalGroups && r.terminalGroups[0] && r.terminalGroups[0].items && r.terminalGroups[0].items[0]\n    if (t) { set(\"terminalGroupId\", t.id); set(\"terminalGroupName\", t.name) }\n  })\n  await lazy([\"productId\", \"productPrice\"], async () => {\n    const r = await call(\"/api/1/nomenclature\", { organizationId: org })\n    const p = (r.products || []).find((x) => x.type === \"Dish\" && !x.isDeleted && x.sizePrices && x.sizePrices[0] && x.sizePrices[0].price && x.sizePrices[0].price.isIncludedInMenu)\n      || (r.products || []).find((x) => x.type === \"Dish\" && !x.isDeleted)\n    if (p) {\n      set(\"productId\", p.id); set(\"productName\", p.name)\n      const price = p.sizePrices && p.sizePrices[0] && p.sizePrices[0].price && p.sizePrices[0].price.currentPrice\n      set(\"productPrice\", price || 0)\n    }\n  })\n  await lazy([\"paymentTypeId\", \"paymentTypeKind\"], async () => {\n    const r = await call(\"/api/1/payment_types\", { organizationIds: [org] })\n    const p = (r.paymentTypes || []).find((x) => x.paymentTypeKind === \"Cash\") || (r.paymentTypes || [])[0]\n    if (p) { set(\"paymentTypeId\", p.id); set(\"paymentTypeKind\", p.paymentTypeKind) }\n  })\n  await lazy([\"orderTypeId\"], async () => {\n    const r = await call(\"/api/1/deliveries/order_types\", { organizationIds: [org] })\n    const items = (r.orderTypes && r.orderTypes[0] && r.orderTypes[0].items) || []\n    const t = items.find((x) => x.orderServiceType === \"DeliveryPickUp\") || items[0]\n    if (t) set(\"orderTypeId\", t.id)\n  })\n  await lazy([\"employeeId\"], async () => {\n    const r = await call(\"/api/1/employees/couriers\", { organizationIds: [org] })\n    const e = r.employees && r.employees[0] && r.employees[0].items && r.employees[0].items[0]\n    if (e) set(\"employeeId\", e.id)\n  })\n  await lazy([\"externalMenuId\"], async () => {\n    const r = await call(\"/api/2/menu\", {})\n    const m = r.externalMenus && r.externalMenus[0]\n    if (m) set(\"externalMenuId\", m.id)\n    const pc = r.priceCategories && r.priceCategories[0]\n    if (pc) set(\"priceCategoryId\", pc.id)\n  })\n  await lazy([\"tableId\"], async () => {\n    if (!get(\"terminalGroupId\")) {\n      const g = await call(\"/api/1/terminal_groups\", { organizationIds: [org], includeDisabled: false })\n      const t = g.terminalGroups && g.terminalGroups[0] && g.terminalGroups[0].items && g.terminalGroups[0].items[0]\n      if (t) set(\"terminalGroupId\", t.id)\n    }\n    const r = await call(\"/api/1/reserve/available_restaurant_sections\", { terminalGroupIds: [get(\"terminalGroupId\")] })\n    const s = r.restaurantSections && r.restaurantSections[0]\n    const tb = s && s.tables && s.tables[0]\n    if (s) set(\"restaurantSectionId\", s.id)\n    if (tb) set(\"tableId\", tb.id)\n  })\n}",
+  "testScript": "// СПРТ • автоматизация iiko Cloud API (после каждого запроса коллекции):\n// запоминает ID из ответов, показывает ошибки iiko в тестах и сбрасывает просроченный токен.\nconst m = String(hopp.request.url || \"\").match(/\\/api\\/\\d\\/[^?\\s#]*/)\nconst p = m ? m[0].replace(/\\/+$/, \"\") : \"\"\nconst status = pw.response.status\nconst b = pw.response.body && typeof pw.response.body === \"object\" ? pw.response.body : {}\n\nconst put = (k, v) => { if (v !== undefined && v !== null && v !== \"\") pw.env.set(k, String(v)) }\nconst fill = (k, v) => { const cur = pw.env.get(k); if (!cur && v !== undefined && v !== null && v !== \"\") pw.env.set(k, String(v)) }\nconst first = (a) => (Array.isArray(a) ? a[0] : undefined)\n\n// ---- проверки: HTTP-статус и ошибка iiko ----\npw.test(\"HTTP \" + status, () => { pw.expect(status).toBeLevel2xx() })\nif (b.errorDescription || b.error) {\n  const text = \"Ошибка iiko: \" + (b.errorDescription || b.error)\n  pw.test(text, () => { pw.expect(b.errorDescription || b.error).toBe(\"\") })\n}\nif (status === 401) {\n  // токен просрочен или неверный: следующий запрос получит новый сам\n  pw.env.set(\"token\", \"\")\n  pw.env.set(\"tokenTime\", \"0\")\n}\n\n// ---- запоминаем ID для следующих запросов ----\nif (/\\/access_token$/.test(p)) {\n  put(\"token\", b.token); put(\"tokenTime\", Date.now())\n} else if (/\\/api\\/1\\/organizations$/.test(p)) {\n  const o = first(b.organizations)\n  if (o) { fill(\"organizationId\", o.id); fill(\"organizationName\", o.name) }\n  put(\"organizationsList\", (b.organizations || []).map((x, i) => `${i + 1}) ${x.name} — ${x.id}`).join(\"\\n\"))\n} else if (/\\/terminal_groups$/.test(p)) {\n  const g = first(b.terminalGroups)\n  const t = g && first(g.items)\n  if (t) { fill(\"terminalGroupId\", t.id); fill(\"terminalGroupName\", t.name) }\n} else if (/\\/(deliveries|order)\\/create$/.test(p)) {\n  if (b.orderInfo) put(\"orderId\", b.orderInfo.id)\n  put(\"correlationId\", b.correlationId)\n} else if (/\\/(deliveries\\/(by_|drafts\\/by_)|order\\/by_)/.test(p)) {\n  const g = first(b.ordersByOrganizations)\n  const o = g && first(g.orders)\n  if (o) fill(\"orderId\", o.id)\n} else if (/\\/employees\\/couriers$/.test(p)) {\n  const g = first(b.employees)\n  const e = g && first(g.items)\n  if (e) fill(\"employeeId\", e.id)\n} else if (/\\/loyalty\\/iiko\\/customer\\/(info|create_or_update)$/.test(p)) {\n  put(\"customerId\", b.id)\n} else if (/\\/api\\/2\\/menu$/.test(p)) {\n  const mm = first(b.externalMenus)\n  if (mm) fill(\"externalMenuId\", mm.id)\n  const pc = first(b.priceCategories)\n  if (pc) fill(\"priceCategoryId\", pc.id)\n} else if (/\\/payment_types$/.test(p)) {\n  const t = first(b.paymentTypes)\n  if (t) { fill(\"paymentTypeId\", t.id); fill(\"paymentTypeKind\", t.paymentTypeKind) }\n} else if (/\\/api\\/1\\/nomenclature$/.test(p)) {\n  const d = (b.products || []).find((x) => x.type === \"Dish\" && !x.isDeleted)\n  if (d) { fill(\"productId\", d.id); fill(\"productName\", d.name) }\n} else if (/\\/reserve\\/available_restaurant_sections$/.test(p)) {\n  const s = first(b.restaurantSections)\n  if (s) { fill(\"restaurantSectionId\", s.id); const t = first(s.tables); if (t) fill(\"tableId\", t.id) }\n} else if (/\\/cities$/.test(p)) {\n  const g = first(b.cities)\n  const c = g && first(g.items)\n  if (c) fill(\"cityId\", c.id)\n}\n",
+  "_ref_id": "coll_mwb4t587_e28f8956-4be5-4282-9921-c928ffa24f26"
+}
