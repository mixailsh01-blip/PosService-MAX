diff --git a/packages/hoppscotch-common/public/learn-app/app.js b/packages/hoppscotch-common/public/learn-app/app.js
new file mode 100644
index 00000000..673516a1
--- /dev/null
+++ b/packages/hoppscotch-common/public/learn-app/app.js
@@ -0,0 +1,93 @@
+(function () {
+  var L = window.LESSONS;
+  var app = document.getElementById("app");
+
+  // Связь с SPRT API (родительское окно). Если страницу открыли отдельно, прогресс хранится локально.
+  var bridge = null;
+  try { if (parent !== window && parent.__sprtLearn) bridge = parent.__sprtLearn; } catch (e) {}
+  var LS = "sprt_learn_progress";
+  var local = (function () { try { return JSON.parse(localStorage.getItem(LS) || "{}"); } catch (e) { return {}; } })();
+  function getProgress() { return bridge ? (bridge.getProgress() || {}) : local; }
+  function setDone(id, v) {
+    if (bridge) bridge.setProgress(id, v);
+    else { local[id] = v; try { localStorage.setItem(LS, JSON.stringify(local)); } catch (e) {} }
+  }
+  function getEnv() { return bridge && bridge.getEnv ? (bridge.getEnv() || {}) : {}; }
+  function go(path) { if (bridge && bridge.go) bridge.go(path); }
+
+  var cur = 0;
+  var mem = {}; // промежуточное состояние урока: {envOk, quizPick}
+  (function pickFirst() { var p = getProgress(); for (var i = 0; i < L.length; i++) if (!p[L[i].id]) { cur = i; return; } cur = L.length - 1; })();
+
+  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]; }); }
+  function doneCount() { var p = getProgress(); return L.filter(function (l) { return p[l.id]; }).length; }
+  function state(l) { return mem[l.id] || (mem[l.id] = { envOk: false, pick: null, envMsg: "" }); }
+
+  function lessonReady(l) {
+    var s = state(l), p = getProgress();
+    if (p[l.id]) return true;
+    var envOk = !l.check || s.envOk;
+    var quizOk = !l.quiz || s.pick === l.quiz.correct;
+    return envOk && quizOk;
+  }
+  function maybeFinish(l) {
+    if (!getProgress()[l.id] && lessonReady(l)) setDone(l.id, true);
+  }
+
+  function render() {
+    var p = getProgress(), n = doneCount(), l = L[cur], s = state(l), isDone = !!p[l.id];
+    var h = '<div class="topbar"><h1 class="ttl">Обучение: iiko Cloud API</h1></div>' +
+      '<p class="sub">Пройдите все шесть уроков, и откроются остальные разделы SPRT API.</p>' +
+      '<div class="prog"><div class="bar"><i style="width:' + Math.round(n / L.length * 100) + '%"></i></div><span>Пройдено ' + n + ' из ' + L.length + '</span></div>';
+    if (n === L.length) {
+      h += '<div class="pass"><b>Обучение пройдено, доступ открыт</b>Теперь вам доступны «Яндекс Еда» и остальные функции SPRT API.' +
+        '<div class="row"><button class="primary" data-go="/yandex">Открыть «Яндекс Еду»</button><button data-go="/">Открыть REST-клиент</button></div></div>';
+    }
+    h += '<div class="layout"><div class="steps">';
+    L.forEach(function (x, i) {
+      h += '<button class="step' + (i === cur ? " cur" : "") + (p[x.id] ? " done" : "") + '" data-i="' + i + '"><span class="n"><span>' + (i + 1) + '</span></span><span>' + esc(x.title) + '</span></button>';
+    });
+    h += '</div><div class="card"><h2>' + (cur + 1) + '. ' + esc(l.title) + '</h2><p class="goal">' + esc(l.goal) + '</p>' + l.html;
+    if (l.task) h += '<div class="task"><b>Практика</b>' + l.task + '</div>';
+    if (l.check) {
+      h += '<div class="check"><button data-check="1"' + (isDone ? " disabled" : "") + '>Проверить</button><span class="res ' + ((s.envOk || isDone) ? "ok" : (s.envMsg ? "bad" : "")) + '">' +
+        (s.envOk || isDone ? "Готово: " + esc(l.check.label) : esc(s.envMsg)) + '</span></div>';
+    }
+    if (l.quiz) {
+      var q = l.quiz, answered = s.pick !== null || isDone;
+      h += '<h3>Контрольный вопрос</h3><div class="quiz"><p class="q">' + esc(q.q) + '</p>';
+      q.options.forEach(function (o, i) {
+        var cls = "opt";
+        if (isDone && i === q.correct) cls += " ok";
+        else if (s.pick === i) cls += i === q.correct ? " ok" : " bad";
+        h += '<button class="' + cls + '" data-opt="' + i + '"' + ((isDone || s.pick === q.correct) ? " disabled" : "") + '>' + esc(o) + '</button>';
+      });
+      if (s.pick !== null) h += '<p class="expl">' + (s.pick === q.correct ? "Верно. " + esc(q.explain) : "Не совсем. Подумайте ещё и выберите другой вариант.") + '</p>';
+      h += '</div>';
+    }
+    h += '<div class="nav"><button data-prev="1"' + (cur === 0 ? " disabled" : "") + '>Назад</button>' +
+      '<button class="primary" data-next="1"' + (cur === L.length - 1 || !(isDone || lessonReady(l)) ? " disabled" : "") + '>Дальше</button></div>';
+    h += '</div></div>';
+    app.innerHTML = h;
+  }
+
+  app.addEventListener("click", function (e) {
+    var t = e.target.closest("button"); if (!t) return;
+    var l = L[cur], s = state(l);
+    if (t.dataset.i !== undefined) { cur = +t.dataset.i; }
+    else if (t.dataset.go) { go(t.dataset.go); return; }
+    else if (t.dataset.prev) { cur = Math.max(0, cur - 1); }
+    else if (t.dataset.next) { cur = Math.min(L.length - 1, cur + 1); }
+    else if (t.dataset.check) {
+      var v = String(getEnv()[l.check.env] || "").trim();
+      s.envOk = !!v;
+      s.envMsg = s.envOk ? "" : "Пока не вижу: заполните окружение «iiko Cloud API», выполните запрос и проверьте снова.";
+      maybeFinish(l);
+    } else if (t.dataset.opt !== undefined) {
+      s.pick = +t.dataset.opt;
+      maybeFinish(l);
+    }
+    render();
+  });
+  render();
+})();
diff --git a/packages/hoppscotch-common/public/learn-app/index.html b/packages/hoppscotch-common/public/learn-app/index.html
new file mode 100644
index 00000000..03f8c21e
--- /dev/null
+++ b/packages/hoppscotch-common/public/learn-app/index.html
@@ -0,0 +1,105 @@
+<!DOCTYPE html>
+<html lang="ru">
+<head>
+<meta charset="UTF-8"/>
+<meta name="viewport" content="width=device-width, initial-scale=1"/>
+<title>Обучение · iiko</title>
+<script>
+  // Оформление берём у SPRT API (родительское окно): цвета темы, акцент, шрифт.
+  // Если страница открыта отдельно, остаются значения по умолчанию из :root ниже.
+  (function(){
+    var MAP={'--bg':'--primary-color','--bg-1':'--primary-light-color','--bg-2':'--primary-dark-color',
+      '--fg':'--secondary-dark-color','--fg-1':'--secondary-color','--fg-2':'--secondary-light-color',
+      '--line':'--divider-dark-color','--line-2':'--divider-dark-color',
+      '--accent':'--accent-color','--accent-2':'--accent-dark-color','--accent-fg':'--accent-contrast-color'};
+    function apply(){
+      try{
+        var pd=parent.document; if(pd===document) return;
+        var cs=parent.getComputedStyle(pd.documentElement), r=document.documentElement;
+        for(var k in MAP){var v=cs.getPropertyValue(MAP[k]).trim(); if(v) r.style.setProperty(k,v);}
+        var c=pd.documentElement.classList;
+        r.classList.toggle('dark',c.contains('dark')||c.contains('black'));
+        var ff=parent.getComputedStyle(pd.body).fontFamily; if(ff) r.style.setProperty('--font',ff);
+      }catch(e){}
+    }
+    function fonts(){
+      try{
+        var css='';
+        Array.prototype.forEach.call(parent.document.styleSheets,function(sh){
+          try{Array.prototype.forEach.call(sh.cssRules,function(rule){ if(rule.type===5) css+=rule.cssText+'\n'; });}catch(e){}
+        });
+        if(css){var st=document.createElement('style'); st.textContent=css; document.head.appendChild(st);}
+      }catch(e){}
+    }
+    apply(); fonts();
+    try{new MutationObserver(apply).observe(parent.document.documentElement,{attributes:true,attributeFilter:['class','data-accent','style']});}catch(e){}
+  })();
+</script>
+<style>
+  :root{--bg:#0f0f0f;--bg-1:#171717;--bg-2:#1f1f1f;--fg:#fafafa;--fg-1:#a3a3a3;--fg-2:#737373;--line:#262626;--line-2:#3a3a3a;
+    --accent:#ef4444;--accent-2:#dc2626;--accent-fg:#fff;--ok:#22c55e;--err:#f87171;
+    --font:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;color-scheme:light}
+  html.dark{color-scheme:dark}
+  html:not(.dark){--err:#dc2626;--ok:#16a34a}
+  *{box-sizing:border-box}
+  body{margin:0;font-family:var(--font)!important;font-size:13px;line-height:1.55;background:var(--bg);color:var(--fg);-webkit-font-smoothing:antialiased}
+  #app{max-width:1040px;margin:0 auto;padding:20px 28px 56px}
+  code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;background:var(--bg-2);border:1px solid var(--line);border-radius:5px;padding:1px 5px}
+  pre{margin:10px 0;padding:12px 14px;background:var(--bg);border:1px solid var(--line);border-radius:8px;overflow:auto;font-size:12px;line-height:1.5}
+  pre code{background:none;border:0;padding:0}
+  button{font:inherit;font-weight:600;font-size:13px;padding:8px 14px;border:1px solid var(--line-2);border-radius:8px;background:var(--bg-1);color:var(--fg);cursor:pointer;transition:border-color .12s,background .12s,color .12s}
+  button:hover:not([disabled]){border-color:var(--accent);color:var(--accent)}
+  button.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
+  button.primary:hover:not([disabled]){background:var(--accent-2);border-color:var(--accent-2);color:var(--accent-fg)}
+  button[disabled]{opacity:.4;cursor:not-allowed}
+  button:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 25%,transparent)}
+
+  .topbar{display:flex;align-items:center;gap:14px;margin:0 0 6px}
+  .ttl{margin:0;font-size:20px;font-weight:700;letter-spacing:-.01em}
+  .sub{color:var(--fg-1);margin:0 0 18px}
+  .prog{display:flex;align-items:center;gap:12px;margin:0 0 20px}
+  .bar{flex:1;height:8px;border-radius:999px;background:var(--bg-2);overflow:hidden}
+  .bar>i{display:block;height:100%;background:var(--accent);border-radius:999px;transition:width .3s}
+  .prog span{color:var(--fg-1);font-size:12px;white-space:nowrap}
+
+  .layout{display:grid;grid-template-columns:270px 1fr;gap:18px;align-items:start}
+  @media(max-width:760px){.layout{grid-template-columns:1fr}}
+  .steps{display:flex;flex-direction:column;gap:6px;position:sticky;top:12px}
+  .step{display:grid;grid-template-columns:28px 1fr;gap:10px;align-items:center;text-align:left;padding:10px 12px;border-radius:10px;background:var(--bg-1);border:1px solid var(--line);color:var(--fg);font-weight:600}
+  .step small{display:block;font-weight:400;color:var(--fg-2);font-size:11px}
+  .step .n{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--bg-2);color:var(--fg-1);font-size:12px}
+  .step.cur{border-color:var(--accent)}
+  .step.done .n{background:var(--ok);color:#fff}
+  .step.done .n:before{content:"✓"}
+  .step.done .n span{display:none}
+
+  .card{background:var(--bg-1);border:1px solid var(--line);border-radius:12px;padding:22px}
+  .card h2{margin:0 0 4px;font-size:18px;letter-spacing:-.01em}
+  .goal{margin:0 0 16px;color:var(--fg-1)}
+  .card h3{margin:20px 0 8px;font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--fg-1)}
+  .card p{margin:8px 0}
+  .card ul,.card ol{margin:8px 0;padding-left:20px}
+  .card li{margin:4px 0}
+  .task{border:1px solid color-mix(in srgb,var(--accent) 45%,var(--line));background:color-mix(in srgb,var(--accent) 7%,transparent);border-radius:10px;padding:12px 14px;margin:14px 0}
+  .task>b:first-child{display:block;margin-bottom:4px}
+  .quiz .q{font-weight:650;margin:0 0 10px}
+  .opt{display:block;width:100%;text-align:left;margin:6px 0;font-weight:500}
+  .opt[disabled]{opacity:.8}
+  .opt.ok{border-color:var(--ok);color:var(--ok)}
+  .opt.bad{border-color:var(--err);color:var(--err)}
+  .expl{margin:10px 0 0;color:var(--fg-1)}
+  .check{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
+  .res{font-size:12px}
+  .res.ok{color:var(--ok)}.res.bad{color:var(--err)}
+  .nav{display:flex;justify-content:space-between;gap:10px;margin-top:22px}
+  .pass{border:1px solid var(--ok);background:color-mix(in srgb,var(--ok) 10%,transparent);border-radius:12px;padding:16px 18px;margin:0 0 18px}
+  .pass b{display:block;font-size:15px;margin-bottom:2px}
+  .pass .row{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
+</style>
+</head>
+<body>
+<div id="app"></div>
+<script src="lessons.js"></script>
+<script src="app.js"></script>
+</body>
+</html>
