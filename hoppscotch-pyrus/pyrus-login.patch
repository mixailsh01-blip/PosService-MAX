+  window.appState.cart = loadCart();
+  window.appState.screen = window.appState.auth?.accessToken ? (window.appState.restaurant?.id ? 'hub' : 'restaurants') : 'auth';
+
+  // Telegram: expand UI
+  try { tg()?.ready?.(); tg()?.expand?.(); } catch (_) {}
+
+  rerender();
+}
+
+bootstrap();
