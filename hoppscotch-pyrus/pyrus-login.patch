+// Corporate build: the app is unusable without signing in.
+// Auth is initialised before the app mounts (see index.ts), but a probable
+// login (stored session) may still be confirming - wait for it first.
+const authSettled = ref(!platform.auth.getProbableUser())
+if (!authSettled.value) {
+  platform.auth
+    .waitProbableLoginToConfirm()
+    .catch(() => {})
+    .finally(() => {
+      authSettled.value = true
+    })
+}
+const currentUser = useReadonlyStream(
+  platform.auth.getCurrentUserStream(),
+  platform.auth.getCurrentUser()
+)
+const loginRequired = computed(
+  () => authSettled.value && currentUser.value === null
