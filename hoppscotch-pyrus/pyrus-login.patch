diff --git a/packages/hoppscotch-common/src/pages/learn.vue b/packages/hoppscotch-common/src/pages/learn.vue
new file mode 100644
index 00000000..818032cd
--- /dev/null
+++ b/packages/hoppscotch-common/src/pages/learn.vue
@@ -0,0 +1,59 @@
+<template>
+  <div class="flex min-h-0 w-full flex-1">
+    <iframe
+      v-if="progress !== undefined"
+      :src="src"
+      title="Обучение · iiko"
+      class="h-full w-full flex-1 border-0"
+    />
+  </div>
+</template>
+
+<script setup lang="ts">
+import { usePageHead } from "@composables/head"
+import { onBeforeUnmount, ref } from "vue"
+import { useRouter } from "vue-router"
+import { useLearnProgress } from "~/helpers/sprt-learn"
+import { getAggregateEnvsWithCurrentValue } from "~/newstore/environments"
+
+const router = useRouter()
+const { progress, setProgress, user } = useLearnProgress()
+
+// метка времени, чтобы после обновления файлов раздел всегда грузился свежим, а не из кеша браузера
+const src = `/learn-app/index.html?t=${Date.now()}`
+
+// Мост для мини-приложения в iframe (тот же адрес, поэтому оно видит parent.__sprtLearn)
+const sprtLearnBridge = {
+  getProgress: () => ({ ...progress.value }),
+  setProgress,
+  getUser: () => ({
+    email: user.value?.email,
+    name: user.value?.displayName,
+  }),
+  // значения переменных выбранного окружения и глобальных (включая секретные)
+  getEnv: () => {
+    const out: Record<string, string> = {}
+    try {
+      for (const v of getAggregateEnvsWithCurrentValue()) {
+        const val = String(v.currentValue || "").trim()
+        if (val && !out[v.key]) out[v.key] = val
+      }
+    } catch (e) {
+      console.error("[sprt-learn] env read failed", e)
+    }
+    return out
+  },
+  go: (path: string) => router.push(path),
+}
+;(window as any).__sprtLearn = sprtLearnBridge
+
+onBeforeUnmount(() => {
+  // При быстром redirect старый экземпляр страницы может размонтироваться
+  // уже после того, как новый установил свой bridge. Не удаляем чужой bridge.
+  if ((window as any).__sprtLearn === sprtLearnBridge) {
+    delete (window as any).__sprtLearn
+  }
+})
+
+usePageHead({ title: ref("Обучение") })
+</script>
