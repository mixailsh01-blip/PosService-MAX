+
+export const getMenuComposition = (restaurantId) => {
+  const { baseUrl } = loadAuth();
+  return req({ method: 'GET', url: `${baseUrl}/menu/${restaurantId}/composition` });
+};
+
+export const getAvailability = (restaurantId) => {
+  const { baseUrl } = loadAuth();
