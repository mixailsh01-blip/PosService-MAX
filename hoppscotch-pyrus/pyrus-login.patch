+<!DOCTYPE html>
+<html lang="ru">
+<head>
+<meta charset="UTF-8"/>
+<meta name="viewport" content="width=device-width, initial-scale=1"/>
+<title>Яндекс Еда · iiko</title>
+<style>
+  /* тёмная тема, когда SPRT API включён в тёмной (класс ставит скрипт ниже) */
+  html.dark{color-scheme:dark}
+  html.dark body{background:#0e0e0e!important;color:#e8e8e8!important}
+  html.dark .card,html.dark .menu-card,html.dark .modRow,html.dark dialog,html.dark button,html.dark input,html.dark textarea{background:#171717!important;color:#e8e8e8!important;border-color:#2c2c2c!important}
+  html.dark button:hover:not([disabled]){border-color:#e0484d!important}
+  html.dark .badge,html.dark .rest-badge{background:#232323!important;color:#bbb!important}
+  html.dark .menu-img,html.dark .modThumb,html.dark .itemDlgImg{background:#232323!important}
+  html.dark .hr{background:#2c2c2c!important}
+  html.dark .totalRow{border-color:#2c2c2c!important}
+  html.dark .dlgActions{background:linear-gradient(to top,#171717 75%,rgba(23,23,23,0))!important}
+  html.dark #err{color:#ff7b7b!important}
+  html.dark dialog::backdrop{background:rgba(0,0,0,.6)}
+</style>
+</head>
+<body>
+<div id="app"></div>
+<script>
+  // подхватываем тему родительского окна (SPRT API): тёмная = класс black/dark на <html>
+  (function(){
+    function apply(){
+      try{
+        var c=parent.document.documentElement.classList;
+        document.documentElement.classList.toggle('dark',c.contains('dark')||c.contains('black'));
+      }catch(e){}
+    }
+    apply();
+    try{new MutationObserver(apply).observe(parent.document.documentElement,{attributes:true,attributeFilter:['class']});}catch(e){}
+  })();
+</script>
+<script type="module" src="./src/app/bootstrap.js"></script>
+</body>
+</html>
diff --git a/packages/hoppscotch-common/public/yandex-app/src/app/bootstrap.js b/packages/hoppscotch-common/public/yandex-app/src/app/bootstrap.js
