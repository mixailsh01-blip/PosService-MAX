diff --git a/packages/hoppscotch-backend/src/auth/pyrus-allowlist.service.ts b/packages/hoppscotch-backend/src/auth/pyrus-allowlist.service.ts
new file mode 100644
index 0000000..17234b8
--- /dev/null
+++ b/packages/hoppscotch-backend/src/auth/pyrus-allowlist.service.ts
@@ -0,0 +1,110 @@
+import { Injectable, Logger, OnModuleInit } from '@nestjs/common';
+import * as https from 'https';
+
+/**
+ * Allowlist of e-mails based on Pyrus organization members.
+ * Enabled only when PYRUS_LOGIN and PYRUS_SECURITY_KEY are set.
+ * When disabled, every e-mail is allowed (stock behaviour).
+ */
+@Injectable()
+export class PyrusAllowlistService implements OnModuleInit {
+  private readonly logger = new Logger(PyrusAllowlistService.name);
+  private readonly login = process.env.PYRUS_LOGIN;
+  private readonly key = process.env.PYRUS_SECURITY_KEY;
+  private readonly extra = (process.env.PYRUS_EXTRA_ALLOWED ?? '')
+    .split(',')
+    .map((s) => s.trim().toLowerCase())
+    .filter(Boolean);
+
+  private emails = new Set<string>();
+  private loaded = false;
+  private refreshing: Promise<void> | null = null;
+
+  get enabled(): boolean {
+    return !!(this.login && this.key);
+  }
+
+  async onModuleInit() {
+    if (!this.enabled) {
+      this.logger.warn('Pyrus allowlist disabled (PYRUS_LOGIN not set)');
+      return;
+    }
+    await this.refresh();
+    setInterval(() => void this.refresh(), 10 * 60 * 1000).unref();
+  }
+
+  private request(
+    url: string,
+    opts: { method?: string; headers?: Record<string, string>; body?: string },
+  ): Promise<any> {
+    return new Promise((resolve, reject) => {
+      const req = https.request(
+        url,
+        { method: opts.method ?? 'GET', headers: opts.headers, timeout: 15000 },
+        (res) => {
+          let data = '';
+          res.on('data', (c) => (data += c));
+          res.on('end', () => {
+            if (!res.statusCode || res.statusCode >= 300)
+              return reject(new Error(`HTTP ${res.statusCode} ${url}`));
+            try {
+              resolve(JSON.parse(data));
+            } catch {
+              reject(new Error(`Bad JSON from ${url}`));
+            }
+          });
+        },
+      );
+      req.on('timeout', () => req.destroy(new Error(`Timeout ${url}`)));
+      req.on('error', reject);
+      if (opts.body) req.write(opts.body);
+      req.end();
+    });
+  }
+
+  refresh(): Promise<void> {
+    if (this.refreshing) return this.refreshing;
+    this.refreshing = (async () => {
+      try {
+        const auth = await this.request('https://accounts.pyrus.com/api/v4/auth', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            login: this.login,
+            security_key: this.key,
+          }),
+        });
+        const apiUrl: string = auth.api_url; // already ends with v4/
+        const res = await this.request(`${apiUrl}members`, {
+          headers: { Authorization: `Bearer ${auth.access_token}` },
+        });
+        const next = new Set<string>();
+        for (const m of res.members ?? []) {
+          if (m.banned === true || !m.email) continue;
+          next.add(String(m.email).toLowerCase());
+        }
+        this.emails = next;
+        this.loaded = true;
+        this.logger.log(`Pyrus members loaded: ${next.size}`);
+      } catch (e) {
+        // keep the previous list on failure
+        this.logger.error(`Pyrus refresh failed: ${(e as Error).message}`);
+      } finally {
+        this.refreshing = null;
+      }
+    })();
+    return this.refreshing;
+  }
+
+  async isAllowed(email: string | null | undefined): Promise<boolean> {
+    if (!this.enabled) return true;
+    if (!email) return false;
+    const e = email.trim().toLowerCase();
+    if (this.extra.includes(e)) return true;
+    if (!this.loaded) await this.refresh();
+    if (this.emails.has(e)) return true;
+    // unknown address: refresh once in case someone was just added
+    await this.refresh();
+    return this.emails.has(e);
+  }
+}
